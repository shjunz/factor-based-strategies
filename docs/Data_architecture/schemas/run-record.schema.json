{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fbs:schema:run-record:1",
  "title": "RunRecord 运行记录",
  "description": "一次 fbs.live rebalance 运行的结果，由 fbs.live.runner._write_record 写入。S3 key: strategy/{name}/records/{exec_session}-rebalance.json",
  "type": "object",
  "required": ["strategy", "mode", "signal_session", "exec_session", "run_at", "status",
               "failures", "notes", "targets", "orders", "submitted"],
  "properties": {
    "strategy": {"type": "string", "description": "策略文件夹名"},
    "mode": {"enum": ["dry_run", "submit"], "description": "submit = 带 --submit 运行"},
    "signal_session": {"type": "string", "format": "date", "description": "算信号用的交易日"},
    "exec_session": {"type": "string", "format": "date", "description": "下单（收盘市价）的交易日"},
    "run_at": {"type": "string", "format": "date-time", "description": "运行时间，America/New_York，带时区偏移"},
    "status": {"enum": ["dry_run", "blocked", "submitted", "partial"]},
    "failures": {"type": "array", "items": {"type": "string"}, "description": "风控或数据检查失败的原因；非空则不下单"},
    "notes": {"type": "array", "items": {"type": "string"}},
    "targets": {
      "type": "object",
      "description": "symbol → 目标权重（资金占比）",
      "additionalProperties": {"type": "number"}
    },
    "orders": {"type": "array", "items": {"$ref": "#/$defs/orderIntent"}},
    "submitted": {"type": "array", "items": {"$ref": "#/$defs/submission"}},
    "turnover": {"type": "number", "minimum": 0, "description": "单边换手 / capital；数据检查失败时没有这个字段"},
    "backtest_report": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}-backtest_.+\\.pdf$", "description": "同一次运行的回测报告文件名（records/ 下）；回测没通过时没有这个字段"}
  },
  "additionalProperties": false,
  "$defs": {
    "orderIntent": {
      "type": "object",
      "required": ["symbol", "side", "qty", "client_order_id", "target_weight", "reason"],
      "properties": {
        "symbol": {"type": "string"},
        "side": {"enum": ["buy", "sell"]},
        "qty": {"type": "integer", "minimum": 1},
        "client_order_id": {
          "type": "string",
          "description": "{strategy}-{exec_session}-{symbol}-{reason}，重跑不变，保证不重复下单"
        },
        "target_weight": {"type": "number"},
        "reason": {"enum": ["open", "close", "adjust"]}
      },
      "additionalProperties": false
    },
    "submission": {
      "type": "object",
      "required": ["client_order_id", "status"],
      "properties": {
        "client_order_id": {"type": "string"},
        "status": {"type": "string", "description": "Alpaca 订单状态、already_present，或 rejected: {原因}"}
      },
      "additionalProperties": false
    }
  }
}
