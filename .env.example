# Copy this file to .env in the repo root and fill in your own keys:
#   cp .env.example .env
# .env is git-ignored. Never commit real keys; only this example file is committed.

# --- Nasdaq Data Link (Sharadar) -------------------------------------------------------
NASDAQ_DATA_LINK_API_KEY=your_nasdaq_data_link_key

# --- Alpaca paper trading --------------------------------------------------------------
# .env can hold as many pairs as you need: one KEY + SECRET pair per paper account / strategy.

# Paper account 1 -> strategy/strategy_example (paper.yaml: account: STRATEGY_EXAMPLE)
ALPACA_STRATEGY_EXAMPLE_KEY=your_api_key_id
ALPACA_STRATEGY_EXAMPLE_SECRET=your_secret_key

# Paper account 2 -> e.g. strategy/my_strategy (paper.yaml: account: MY_STRATEGY)
ALPACA_MY_STRATEGY_KEY=your_api_key_id
ALPACA_MY_STRATEGY_SECRET=your_secret_key

# Paper account 3 -> e.g. strategy/another_strategy (paper.yaml: account: ANOTHER_STRATEGY)
ALPACA_ANOTHER_STRATEGY_KEY=your_api_key_id
ALPACA_ANOTHER_STRATEGY_SECRET=your_secret_key
